        {
            "id": "https://example.org/storymap/issue-455-audio/canvas/2",
            "type": "Canvas",
            "height": 1080,
            "width": 1080,
            "items": [
                {
                    "id": "https://example.org/storymap/issue-455-audio/canvas/2/annotationpage/1",
