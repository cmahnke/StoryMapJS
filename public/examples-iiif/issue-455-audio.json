{
    "@context": [
        "http://iiif.io/api/presentation/3/context.json",
        "http://iiif.io/api/extension/navplace/context.json",
        "https://cmahnke.github.io/StoryMapJS/context.json"
    ],
    "id": "https://example.org/storymap/issue-455-audio",
