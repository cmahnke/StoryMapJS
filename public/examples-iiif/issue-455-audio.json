                    "items": [
                        {
                            "id": "https://example.org/storymap/issue-455-audio/canvas/2/annotation/1",
                            "type": "Annotation",
                            "motivation": "painting",
                            "body": {
                                "type": "TextualBody",
                                "format": "text/html",
