{
    "@context": [
        "http://iiif.io/api/presentation/3/context.json",
        "http://iiif.io/api/extension/navplace/context.json",
        "https://cmahnke.github.io/StoryMapJS/context.json"
    ],
    "id": "https://example.org/storymap/issue-image-srcset",
    "type": "Manifest",
    "label": {
        "none": [
            "issue-image-srcset"
        ]
    },
    "behavior": [
        "paged"
    ],
    "provider": [
        {
            "id": "https://example.org/",
            "type": "Agent",
            "label": {
                "none": [
                    "StoryMapJS"
                ]
            }
        }
    ],
    "items": [
        {
            "id": "https://example.org/storymap/issue-image-srcset/canvas/1",
            "type": "Canvas",
            "height": 1080,
            "width": 1080,
            "items": [
                {
                    "id": "https://example.org/storymap/issue-image-srcset/canvas/1/annotationpage/1",
                    "type": "AnnotationPage",
                    "items": [
                        {
                            "id": "https://example.org/storymap/issue-image-srcset/canvas/1/annotation/1",
                            "type": "Annotation",
                            "motivation": "painting",
                            "body": {
                                "type": "TextualBody",
                                "format": "text/html",
                                "value": "/examples/assets/placeholder-portrait.jpg"
                            },
                            "target": "https://example.org/storymap/issue-image-srcset/canvas/1"
                        }
                    ]
                }
            ],
            "label": {
                "none": [
                    "Responsive images"
                ]
            },
            "summary": {
                "none": [
                    "The srcset/sizes fields pass through to the img element."
                ]
            },
            "storymap:type": "overview",
            "storymap:mediaCaption": "srcset passthrough"
        }
    ],
    "service": [
        {
            "id": "https://example.org/storymap/issue-image-srcset/map-config",
            "type": "Service",
            "profile": "https://cmahnke.github.io/StoryMapJS/context.json/mapconfig",
            "storymap:mapType": "osm",
            "storymap:mapAsImage": false,
            "storymap:callToAction": false
        }
    ]
}
