    "id": "https://example.org/storymap/annotated-image",
    "type": "Manifest",
    "label": {
        "none": [
            "Annotation-driven tour"
        ]
    },
    "summary": {
        "none": [
            "One canvas as an image map, four tour stops: every commenting, tagging, classifying or describing annotation with a fragment target becomes a slide that fits the region it points at."
        ]
    },
    "requiredStatement": {
        "label": {
            "none": [
                "Attribution"
            ]
        },
        "value": {
            "none": [
                "The Laoco\u00f6n and His Sons, IIIF Image API example reference"
            ]
        }
    },
    "provider": [
        {
            "id": "https://example.org/",
            "type": "Agent",
            "label": {
                "none": [
                    "StoryMapJS"
                ]
            }
        }
    ],
    "service": [
        {
            "id": "https://example.org/storymap/annotated-image/map-config",
            "type": "Service",
            "profile": "https://cmahnke.github.io/StoryMapJS/context.json/mapconfig",
            "storymap:basemap": "iiif",
            "storymap:mapAsImage": true
        }
    ],
    "items": [
        {
            "id": "https://example.org/storymap/annotated-image/canvas/1",
            "type": "Canvas",
            "height": 3000,
            "width": 2315,
            "label": {
                "none": [
                    "The sculpture"
                ]
            },
            "summary": {
                "none": [
                    "The whole panel, before any detail."
                ]
            },
            "storymap:type": "overview",
