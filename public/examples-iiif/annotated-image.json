                    ]
                },
                {
                    "id": "https://example.org/storymap/annotated-image/canvas/1/annotationpage/2",
                    "type": "AnnotationPage",
                    "items": [
                        {
                            "id": "https://example.org/storymap/annotated-image/canvas/1/annotation/101",
                            "type": "Annotation",
                            "motivation": "commenting",
                            "body": {
                                "type": "TextualBody",
                                "format": "text/plain",
                                "value": "First paragraph of the stop.\n\nSecond paragraph, separated by a blank line."
                            },
                            "target": {
                                "type": "SpecificResource",
                                "source": "https://example.org/storymap/annotated-image/canvas/1",
                                "selector": {
                                    "type": "FragmentSelector",
                                    "value": "xywh=700,300,900,900"
                                }
                            }
                        },
                        {
