{
    "name": "@projektemacher/storymapjs",
    "version": "0.10.0",
    "description": "StoryMapJS is a tool for telling stories through the context of places on a map. For more information, see storymap.knightlab.com",
    "license": "MPL-2.0",
    "type": "module",
    "author": "Christian Mahnke <194820+cmahnke@users.noreply.github.com>",
    "files": [
        "dist",
        "schema",
        "README.md",
        "CHANGELOG"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cmahnke/StoryMapJS.git"
    },
    "bugs": {
        "url": "https://github.com/cmahnke/StoryMapJS/issues"
    },
    "homepage": "https://github.com/cmahnke/StoryMapJS#readme",
    "engines": {
        "node": ">=22"
    },
    "exports": {
        ".": "./dist/js/storymap.js",
        "./css/storymap.css": "./dist/css/storymap.css",
        "./css/fonts/*": "./dist/css/fonts/*",
        "./schema/*": "./schema/*"
    },
    "dependencies": {
        "@fontsource-utils/scss": "^0.2.4",
        "js-cookie": "^3.0.8",
        "morpheus": "^0.7.2",
        "ol": "^10.10.0",
        "ol-mapbox-style": "^13.5.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@fontsource-variable/bitter": "^5.3.0",
        "@fontsource-variable/dancing-script": "^5.3.0",
        "@fontsource-variable/eb-garamond": "^5.3.0",
        "@fontsource-variable/open-sans": "^5.3.0",
        "@fontsource-variable/playfair-display": "^5.3.0",
        "@fontsource-variable/raleway": "^5.3.0",
        "@fontsource-variable/roboto-slab": "^5.3.0",
        "@fontsource-variable/vollkorn": "^5.3.0",
        "@fontsource/abril-fatface": "^5.3.0",
        "@fontsource/amatic-sc": "^5.3.0",
        "@fontsource/average-sans": "^5.3.0",
        "@fontsource/bitter": "^5.3.0",
        "@fontsource/clicker-script": "^5.3.0",
        "@fontsource/fauna-one": "^5.3.0",
        "@fontsource/gentium-book-plus": "^5.3.0",
        "@fontsource/lato": "^5.3.0",
        "@fontsource/megrim": "^5.3.0",
        "@fontsource/old-standard-tt": "^5.3.0",
        "@fontsource/playfair-display-sc": "^5.3.0",
        "@fontsource/pt-sans": "^5.3.0",
        "@fontsource/pt-sans-narrow": "^5.3.0",
        "@fontsource/pt-serif": "^5.3.0",
        "@fontsource/rufina": "^5.3.0",
        "@fontsource/ubuntu": "^5.3.0",
        "@fontsource/unica-one": "^5.3.0",
        "@playwright/test": "^1.63.0",
        "@types/js-cookie": "^3.0.6",
        "@types/node": "^26.6.2",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "jsdom": "^30.1.0",
        "marked": "^18.0.13",
        "prettier": "^3.9.8",
        "sass": "^1.104.1",
        "stylelint": "^17.15.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typedoc": "^0.28.20",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    },
    "scripts": {
        "dev": "vite",
        "build": "node tasks/build-fonts.mjs && node tasks/build-docs.mjs && npm run docs:api && vite build && vite build --config vite.demo.config.ts",
        "docs": "node tasks/build-docs.mjs",
        "docs:api": "typedoc",
        "thumbs": "node tasks/build-thumbnails.mjs",
        "preview": "vite preview",
        "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
        "dist": "npm run clean && npm run build && cp dist/js/storymap.js dist/js/storymap-min.js",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit",
        "validate": "node scripts/validate-storymap.mjs",
        "validate:iiif": "node scripts/validate-iiif.mjs",
        "lint": "eslint . && stylelint 'src/scss/**/*.scss'",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": []
}
