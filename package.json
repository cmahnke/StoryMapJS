    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --config vite.demo.config.ts && node tasks/build-fonts.mjs",
        "preview": "vite preview",
        "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit",
        "validate": "node scripts/validate-storymap.mjs",
        "lint": "eslint . && stylelint 'src/scss/**/*.scss'",
        "dist": "npm run clean build && cp dist/js/storymap.js dist/js/storymap-min.js"
