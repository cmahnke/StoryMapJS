{
    "name": "StoryMapJS",
    "version": "0.9.6",
    "description": "StoryMapJS is a tool for telling stories through the context of places on a map. For more information, see storymap.knightlab.com",
    "private": "true",
    "engines": {
        "node": ">=22"
    },
    "directories": {
        "test": "tests"
    },
    "dependencies": {
        "adm-zip": "^0.6.1",
        "leaflet": "^1.9.4",
        "mini-css-extract-plugin": "^2.10.2",
        "prompt": "^1.3.0",
        "simple-git": "^3.36.0",
        "trash-cli": "^7.2.0",
        "uglify-js": "^3.19.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/leaflet": "^1.9.22",
        "clean-webpack-plugin": "^4.0.0",
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.5",
        "file-loader": "^6.2.0",
        "fs-extra": "^11.4.0",
        "html-webpack-plugin": "^5.6.8",
        "jsdom": "^30.1.0",
        "json-loader": "^0.5.7",
        "jstrace": "^0.3.0",
        "less": "^4.9.1",
        "less-loader": "^13.0.0",
        "npm-run-all": "^4.1.5",
        "run-all": "^1.0.1",
        "run-s": "0.0.0",
        "style-loader": "^4.0.0",
        "terser-webpack-plugin": "^5.6.1",
        "trash": "^10.1.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.0",
        "vitest": "^5.0.1",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3",
        "webpack-dev-server": "^6.0.0",
        "webpack-merge": "^6.0.1"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --config vite.demo.config.ts",
        "preview": "vite preview",
        "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "dist": "npm run clean build && cp dist/js/storymap.js dist/js/storymap-min.js"
    },
